# Copie ce fichier en ".env" puis remplis les valeurs.
# Le fichier .env n'est jamais envoyé sur Git (voir .gitignore).

# Token donné par @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Ton identifiant de conversation (voir TUTORIEL.md, étape 2)
TELEGRAM_CHAT_ID=123456789

# Adresse et port de l'API
API_ADDR=127.0.0.1:3000

# Mot de passe que devront fournir ceux qui appellent l'API
API_KEY=change-moi-par-un-long-secret
